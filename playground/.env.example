# Playground settings. Copy this file to playground/.env and fill in what you need.
# Everything is optional: with no .env at all, every flow except Google/Apple/Facebook works.

# Database (default: the Docker one started by `npm run playground:db`)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/techelusive_playground

# Count rate limits in Redis instead of memory (Docker starts one on 6379)
# REDIS_URL=redis://localhost:6379

# Web-app mode: refresh token in an HttpOnly cookie instead of the JSON body (comma-separated origins)
# REFRESH_TOKEN_COOKIE_ORIGINS=http://localhost:3000

# Reject passwords found in data breaches (off in the playground, on in real apps)
# CHECK_BREACHED_PASSWORDS=true

# Google sign-in: a "Web application" OAuth client from Google Cloud Console,
# with http://localhost:3000 as an authorized JavaScript origin
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Apple sign-in: your Services ID (paste Apple identity tokens into Postman's socialToken)
# APPLE_CLIENT_ID=com.example.web

# Facebook sign-in: from developers.facebook.com (paste user access tokens into Postman's socialToken)
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# ----- Real delivery (optional). Every message still appears on the dashboard too. -----

# Real emails through Resend (resend.com, free tier). Without your own verified domain, Resend only
# delivers to the email address of your Resend account, so register with that address.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Techelusive Playground <onboarding@resend.dev>

# Real SMS through MSG91. Indian numbers need a DLT-approved template whose code variable matches.
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_CODE_VARIABLE=otp
