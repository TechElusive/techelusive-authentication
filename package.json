{
  "name": "@techelusive/nest-auth",
  "version": "0.2.0",
  "description": "Reusable, production-grade authentication for NestJS apps: passwords, codes, magic links, social, passkeys, 2FA, organizations and API keys, stored in each app's own database",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TechElusive/techelusive-authentication.git"
  },
  "homepage": "https://github.com/TechElusive/techelusive-authentication#readme",
  "bugs": {
    "url": "https://github.com/TechElusive/techelusive-authentication/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "api",
    "dist",
    "docs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "test": "node --test --require ts-node/register --require tsconfig-paths/register test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.playground.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "e2e": "node scripts/e2e-check.js",
    "check-migration": "node scripts/check-migration.js",
    "api-specs": "node scripts/api/generate-api-specs.js",
    "playground:db": "docker compose -f playground/docker-compose.yml up -d",
    "playground:build": "tsc -p tsconfig.playground.json && tsc-alias -p tsconfig.playground.json",
    "playground": "npm run build && npm run api-specs && npm run playground:build && node dist-playground/playground/main.js",
    "check:http": "node scripts/http-flow-check.js",
    "check:cookies": "node scripts/http-cookie-check.js"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "typeorm": "^0.3.20"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.700.0",
    "@simplewebauthn/server": "^13.1.0",
    "argon2": "^0.41.1"
  },
  "optionalDependencies": {
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.8",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^0.3.20",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "nestjs",
    "authentication",
    "auth",
    "typeorm",
    "postgresql",
    "jwt",
    "passkeys",
    "webauthn",
    "totp",
    "2fa",
    "oauth",
    "otp",
    "magic-link"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
